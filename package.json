{
  "name": "sabiget",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev:legacy",
    "build": "npm --prefix frontend run build",
    "test:backend": "npm --prefix backend run test"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "scripts-prod": {
    "docker:prod:build": "docker compose -f docker-compose.prod.yml build",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d --remove-orphans",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down -v"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
