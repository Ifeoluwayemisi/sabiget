# Debian-based image: Prisma's native engines require OpenSSL, which Alpine
# (musl) images do not ship by default, causing schema-engine crashes during
# prisma generate/migrate. node:18-slim ships libssl3.
FROM node:18-slim AS builder
WORKDIR /app
COPY package*.json ./
# Install all dependencies (including dev deps) for build and Prisma
RUN npm ci
COPY . .
# Generate Prisma client (requires deps)
RUN npx prisma generate

FROM node:18-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
# Create non-root user
RUN addgroup -S sabiget && adduser -S sabiget -G sabiget
COPY --from=builder /app .
RUN chown -R sabiget:sabiget /app
USER sabiget
EXPOSE 5000
CMD ["node", "src/app.js"]
