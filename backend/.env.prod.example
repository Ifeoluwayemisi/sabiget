# Example production environment for the SabiGet backend.
# Set real values in your secret manager. Never commit real credentials.

# Database / Redis (Docker Compose service names for internal networking)
DATABASE_URL=postgresql://postgres:postgres@db:5432/sabiget?schema=public
REDIS_URL=redis://redis:6379

# JWT secrets - set securely in your environment/secret manager
JWT_ACCESS_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME

# Paystack (payments)
PAYSTACK_SECRET_KEY=REPLACE_ME
PAYSTACK_PUBLIC_KEY=REPLACE_ME
PAYSTACK_BASE_URL=https://api.paystack.co

# Browser-reachable Paystack redirect target after payment.
PAYSTACK_CALLBACK_URL=https://your-frontend-domain.example/payment-callback

# Notifications (WhatsApp-first OTP via Meta WhatsApp Cloud API; email via Brevo).
# No SMS. OTP falls back to Brevo email, then (dev only) the console channel.
# Production must configure at least one live provider; the code is never logged.
META_WHATSAPP_ACCESS_TOKEN=REPLACE_ME
META_WHATSAPP_PHONE_NUMBER_ID=REPLACE_ME
META_WHATSAPP_BUSINESS_ACCOUNT_ID=REPLACE_ME
META_WHATSAPP_API_VERSION=v20.0
META_WHATSAPP_OTP_TEMPLATE=sabiget_otp
META_WHATSAPP_ORDER_TEMPLATE=sabiget_order_status
BREVO_API_KEY=REPLACE_ME
BREVO_SENDER_EMAIL=no-reply@your-domain.example
BREVO_SENDER_NAME=SabiGet

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# Service Fee Configuration
SERVICE_FEE_NAIRA=500
VENDOR_SEARCH_RADIUS_KM=5

# DVC (Delivery Verification Code)
DVC_LENGTH=6
DVC_LOCKOUT_MINUTES=15
DVC_MAX_ATTEMPTS=3

# Other settings
NODE_ENV=production
PORT=5000
BACKEND_URL=https://api.your-frontend-domain.example
FRONTEND_URL=https://your-frontend-domain.example