{
  "name": "sabiget-backend",
  "version": "1.0.0",
  "description": "Backend for SabiGet - Location-aware multi-vendor food marketplace",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --testMatch \"**/src/test/**/*.test.js\"",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch --testMatch \"**/src/test/**/*.test.js\""
  },
  "author": "Racheal",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@prisma/client": "^5.8.0",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "redis": "^4.6.12",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prisma": "^5.8.0"
  }
}
