generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  phone          String          @unique
  email          String?         @unique
  name           String?
  password       String?
  role           Role            @default(GUEST)
  isVerified     Boolean         @default(false)
  verifiedAt     DateTime?
  loyaltyPoints  Int             @default(0)
  pointsEarned   Int             @default(0)
  pointsRedeemed Int             @default(0)
  orderCount     Int             @default(0)
  profileImage   String?
  address        String?
  lastLocation   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  lastLoginAt    DateTime?
  auditLogs      AuditLog[]      @relation("AdminUser")
  disputeReports DisputeReport[]
  orders         Order[]
  refreshTokens  RefreshToken[]
  reviews        Review[]
  vendor         Vendor?

  @@index([phone])
  @@index([role])
}

model Vendor {
  id              String         @id @default(cuid())
  name            String
  description     String?
  latitude        Float?
  longitude       Float?
  lga             String?
  address         String?
  serviceRadius   Float          @default(5.0)
  isVerified      Boolean        @default(false)
  verifiedAt      DateTime?
  isActive        Boolean        @default(true)
  kybStatus       KYBStatus      @default(PENDING)
  tinNumber       String?        @unique
  cacNumber       String?        @unique
  cacDocument     String?
  ninNumber       String?
  phone           String         @unique
  email           String?        @unique
  paystackSubcode String?        @unique
  bankAccount     String?
  bankCode        String?
  averageRating   Float          @default(0.0)
  totalReviews    Int            @default(0)
  logo            String?
  bannerImage     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders          Order[]
  products        Product[]
  reviews         Review[]
  metrics         VendorMetrics?

  @@index([latitude, longitude])
  @@index([lga])
  @@index([isVerified])
  @@index([isActive])
}

model Product {
  id              String      @id @default(cuid())
  vendorId        String
  name            String
  description     String?
  price           Float
  imageUrl        String?
  isAvailable     Boolean     @default(true)
  preparationTime Int         @default(15)
  category        String?
  tags            String[]    @default([])
  stockQuantity   Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]
  vendor          Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([isAvailable])
}

model Order {
  id                   String       @id @default(cuid())
  userId               String
  vendorId             String
  status               OrderStatus  @default(UNPAID)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  acceptedAt           DateTime?
  preparedAt           DateTime?
  deliveredAt          DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  foodCost             Float
  serviceFee           Float
  platformFee          Float        @default(0)
  totalAmount          Float
  paymentReference     String?      @unique
  paystackAccessCode   String?
  paymentGateway       String       @default("paystack")
  idempotencyKey       String       @unique
  dvcCode              String?
  dvcAttempts          Int          @default(0)
  dvcLockedUntil       DateTime?
  dvcEnteredAt         DateTime?
  deliveryAddress      String
  deliveryLat          Float
  deliveryLng          Float
  acceptanceDeadline   DateTime?
  autoKilledAt         DateTime?
  hasDispute           Boolean      @default(false)
  disputeReason        String?
  disputeResolvedAt    DateTime?
  refundInitiatedAt    DateTime?
  refundCompletedAt    DateTime?
  refundAmount         Float?
  preparingFlaggedAt   DateTime?
  preparingPingedAt    DateTime?
  forceRefundedByAdmin Boolean      @default(false)
  adminNotes           String?
  pointsEarned         Int          @default(0)
  pointsRedeemed       Int          @default(0)
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor               Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items                OrderItem[]
  reviews              Review[]
  webhookLogs          WebhookLog[]

  @@index([userId])
  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentReference])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  quantity        Int
  pricePerUnit    Float
  totalPrice      Float
  specialRequests String?
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Review {
  id             String   @id @default(cuid())
  orderId        String?
  userId         String
  vendorId       String
  rating         Int
  comment        String?
  foodQuality    Int?
  deliverySpeed  Int?
  driverBehavior Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  order          Order?   @relation(fields: [orderId], references: [id])
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor         Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vendorId])
  @@index([rating])
}

model VendorMetrics {
  id                 String   @id @default(cuid())
  vendorId           String   @unique
  acceptanceRate     Float    @default(0.0)
  totalAccepted      Int      @default(0)
  totalRejected      Int      @default(0)
  avgPreparationTime Int      @default(0)
  cancellationRate   Float    @default(0.0)
  totalCancelled     Int      @default(0)
  dvcSuccessRate     Float    @default(0.0)
  totalDvcSuccess    Int      @default(0)
  totalDvcFailed     Int      @default(0)
  customerRetention  Float    @default(0.0)
  uniqueCustomers    Int      @default(0)
  repeatOrders       Int      @default(0)
  meritScore         Float    @default(0.0)
  rank               Int?
  totalOrderValue    Float    @default(0.0)
  totalPayout        Float    @default(0.0)
  pendingPayout      Float    @default(0.0)
  updatedAt          DateTime @default(now()) @updatedAt
  vendor             Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([meritScore])
  @@index([rank])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  action     String
  targetType String
  targetId   String
  changes    Json?
  ipAddress  String?
  userAgent  String?
  reason     String?
  createdAt  DateTime @default(now())
  admin      User?    @relation("AdminUser", fields: [adminId], references: [id])

  @@index([action])
  @@index([targetType])
  @@index([createdAt])
}

model DisputeReport {
  id          String        @id @default(cuid())
  orderId     String?
  userId      String
  reportType  DisputeType
  description String
  evidence    String?
  status      DisputeStatus @default(OPEN)
  resolvedBy  String?
  resolution  String?
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}

model OTPLog {
  id          String    @id @default(cuid())
  phone       String
  code        String
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  isUsed      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?

  @@index([phone, expiresAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model RateLimitLog {
  id        String   @id @default(cuid())
  key       String
  count     Int      @default(0)
  maxLimit  Int
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([key, expiresAt])
}

model WebhookLog {
  id          String    @id @default(cuid())
  orderId     String
  provider    String
  event       String
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([provider])
  @@index([event])
  @@index([processed])
}

model PaymentSettlement {
  id             String           @id @default(cuid())
  vendorId       String
  totalAmount    Float
  settlementDate DateTime
  status         SettlementStatus @default(PENDING)
  processedAt    DateTime?
  transactionId  String?
  createdAt      DateTime         @default(now())

  @@index([vendorId])
  @@index([status])
  @@index([settlementDate])
}

enum Role {
  GUEST
  MEMBER
  VENDOR
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  UNPAID
  PENDING
  ACCEPTED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED_CUSTOMER
  CANCELLED_VENDOR
  CANCELLED_AUTO_KILL
  CANCELLED_ADMIN
  DISPUTED
  REFUNDED
}

enum KYBStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum DisputeType {
  FOOD_NOT_RECEIVED
  POOR_FOOD_QUALITY
  INCORRECT_ORDER
  DELIVERY_LATE
  WRONG_DELIVERY_ADDRESS
  VENDOR_NO_SHOW
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  ESCALATED
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
