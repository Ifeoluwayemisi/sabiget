# Example environment variables for SabiGet backend

# Database
# Use a format compatible with Prisma/Postgres. Do NOT commit real credentials.
DATABASE_URL="postgresql://postgres:password@localhost:5432/sabiget?schema=public"

# JWT Secrets (generate 32+ byte random hex strings)
JWT_ACCESS_SECRET="REPLACE_WITH_SECURE_RANDOM_HEX_32_PLUS"
JWT_REFRESH_SECRET="REPLACE_WITH_SECURE_RANDOM_HEX_32_PLUS"

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# Paystack (payments) - use test keys for local/dev
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"
PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"
PAYSTACK_BASE_URL="https://api.paystack.co"

# Where Paystack redirects the customer after payment (browser-reachable URL).
# Defaults to ${FRONTEND_URL}/payment-callback when unset.
PAYSTACK_CALLBACK_URL="http://localhost:3000/payment-callback"

# Notifications (WhatsApp-first OTP via Meta WhatsApp Cloud API; email fallback via Brevo)
# SabiGet does NOT use SMS. Fallback order is WhatsApp -> Brevo email -> the
# explicit development console channel (dev only; production never prints codes).
META_WHATSAPP_ACCESS_TOKEN="your_meta_whatsapp_access_token"
META_WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
META_WHATSAPP_BUSINESS_ACCOUNT_ID="your_whatsapp_business_account_id"
META_WHATSAPP_API_VERSION="v20.0"
META_WHATSAPP_OTP_TEMPLATE="sabiget_otp"
META_WHATSAPP_ORDER_TEMPLATE="sabiget_order_status"
BREVO_API_KEY="your_brevo_api_key"
BREVO_SENDER_EMAIL="no-reply@your-domain.com"
BREVO_SENDER_NAME="SabiGet"

# Redis (for rate limiting, OTP caching)
REDIS_URL="redis://localhost:6379"

# Service Fee Configuration
SERVICE_FEE_NAIRA=500
VENDOR_SEARCH_RADIUS_KM=5

# DVC (Delivery Verification Code)
DVC_LENGTH=6
DVC_LOCKOUT_MINUTES=15
DVC_MAX_ATTEMPTS=3

# Admin Configuration
ADMIN_PREPARING_FLAG_MINUTES=40
ADMIN_FORCE_REFUND_MINUTES=55
ADMIN_SMS_THRESHOLD_MINUTES=5

# Loyalty Points
LOYALTY_POINTS_FIRST_3_ORDERS_RATE=0.05
LOYALTY_POINTS_DEFAULT_RATE=0.02

# Geo Anonymization
GEO_RETENTION_DAYS=60

# Server
NODE_ENV="development"
PORT=5000
BACKEND_URL="http://localhost:5000"
FRONTEND_URL="http://localhost:3000"

# Optional CI/build tuning (uncomment in CI or use real .env)
# NODE_OPTIONS=--max-old-space-size=4096
# RAYON_NUM_THREADS=2
